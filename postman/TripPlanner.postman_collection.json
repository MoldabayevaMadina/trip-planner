{
  "info": {
    "name": "Trip Planner API",
    "description": "All endpoints of the Trip Planner API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Trips",
      "item": [
        {
          "name": "List trips",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trips/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                ""
              ]
            },
            "description": "All trips."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                ""
              ]
            },
            "description": "Creates a trip. The city is geocoded (Nominatim) and a day is created for every date. Saves the new id to {{tripId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Istanbul with friends\",\n  \"city\": \"Istanbul\",\n  \"start_date\": \"2026-11-10\",\n  \"end_date\": \"2026-11-13\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const trip = pm.response.json();",
                  "pm.collectionVariables.set(\"tripId\", trip.id);",
                  "pm.test(\"City was geocoded\", () => {",
                  "    pm.expect(trip.latitude).to.be.a(\"number\");",
                  "    pm.expect(trip.country).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get trip",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "{{tripId}}",
                ""
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Same trip\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"tripId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update trip (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "{{tripId}}",
                ""
              ]
            },
            "description": "Full update: all writable fields are sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Istanbul — long weekend\",\n  \"city\": \"Istanbul\",\n  \"start_date\": \"2026-11-10\",\n  \"end_date\": \"2026-11-13\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Partial update trip (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "{{tripId}}",
                ""
              ]
            },
            "description": "Only the sent fields change.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Istanbul with friends 🇹🇷\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Title changed\", () => pm.expect(pm.response.json().title).to.include(\"Istanbul with friends\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trip days with weather",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/days/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "{{tripId}}",
                "days",
                ""
              ]
            },
            "description": "Days of the trip with places and weather (Open-Meteo, cached for 3 hours). Saves the first two day ids to {{dayId}} and {{day2Id}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"4 days created from the dates\", () => pm.expect(data.days.length).to.eql(4));",
                  "pm.collectionVariables.set(\"dayId\", data.days[0].id);",
                  "pm.collectionVariables.set(\"day2Id\", data.days[1].id);"
                ]
              }
            }
          ]
        }
      ]
