        {
          "name": "Trip days with weather",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\n\nconst data = pm.response.json();\n// save the first two days for the next requests\npm.collectionVariables.set(\"dayId\", data.days[0].id);\npm.collectionVariables.set(\"day2Id\", data.days[1].id);\n\npm.test(\"One day for every date of the trip\", () => {\n    const start = new Date(data.trip.start_date);\n    const end = new Date(data.trip.end_date);\n    const expected = Math.round((end - start) / 86400000) + 1; \n    pm.expect(data.days.length).to.eql(expected);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/days/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "{{tripId}}",
                "days",
                ""
              ]
            },
            "description": "Days of the trip with places and weather (Open-Meteo, cached for 3 hours). Saves the first two day ids to {{dayId}} and {{day2Id}}."
          },
          "response": []
        }
